# Use a PostgreSQL connection string from your local PostgreSQL or hosted provider.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/cadms?schema=public"

# Generate a long, random secret. Do not commit your real .env file.
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="8h"
PORT=5000
NODE_ENV="development"

# Comma-separated frontend origins. Example: http://localhost:3000
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Optional bootstrap admin used by prisma/seed.js
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PHONE="01700000000"
SEED_ADMIN_PASSWORD="ChangeThisStrongPassword123!"
